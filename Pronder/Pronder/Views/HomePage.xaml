<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pronder.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pronder.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="PagePanel" Grid.Row="1" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left" IsPaneOpen="False">
            <StackPanel Orientation="Vertical" Padding="32, 32, 32, 64">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Height="128" Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            
                        </StackPanel>
                    </Button>
                    <Button Height="128" Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">

                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </NavigationView>
    </Grid>
</Page>
