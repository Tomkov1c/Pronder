<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pronder.Custom.CustomContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pronder.Custom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CornerRadius="{StaticResource OverlayCornerRadius}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">1300</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
            <x:Double x:Key="ContentDialogMinWidth">700</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">550</x:Double>
            <Thickness x:Key="ContentDialogPadding">0</Thickness>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid>
        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MinWidth="700"
              Padding="0, 24, 24, 24" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Button Width="150" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</ContentDialog>
