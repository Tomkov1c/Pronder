<Page
    x:Class="Pronder.Views.SettingsInterfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Spacing="16">
        <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="General"/>
            <controls:SettingsCard Header="App theme" HeaderIcon="{ui:FontIcon Glyph=&#xE790;}" >
                <ComboBox x:Name="Settings_Theme_ComboBox" SelectedItem="{Binding ElementTheme, Mode=OneWay}" 
                          SelectedIndex="{Binding SelectedThemeIndex}"
                          SelectionChanged="ThemeChange" FontSize="15" VerticalAlignment="Center" 
                          HorizontalAlignment="Right" Width="250">
                    <ComboBoxItem x:Uid="Settings_Theme_Light">Light</ComboBoxItem>
                    <ComboBoxItem x:Uid="Settings_Theme_Dark">Dark</ComboBoxItem>
                    <ComboBoxItem x:Uid="Settings_Theme_Default">Default</ComboBoxItem>
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Smoothness" HeaderIcon="{ui:FontIcon Glyph=&#xEC4A;}"
                                   Description="" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Pane"/>
            <controls:SettingsExpander Header="Global pages" HeaderIcon="{ui:FontIcon Glyph=&#xE700;}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Home" HeaderIcon="{ui:FontIcon Glyph=&#xE80F;}"/>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsCard Header="Order" HeaderIcon="{ui:FontIcon Glyph=&#xE8CB;}"
                                   Description="Choose the preferred order for displaying projects">
                <ComboBox VerticalAlignment="Center"  HorizontalAlignment="Right" Width="250" 
                          SelectedIndex="{Binding SelectedPaneOrderIndex, Mode=TwoWay}">
                    <ComboBoxItem Tag="AscendingByName">Ascending By Name</ComboBoxItem>
                    <ComboBoxItem Tag="DescendingByName">Descending By Name</ComboBoxItem>
                    <ComboBoxItem Tag="AscendingByDateVisited">Ascending By DateVisited</ComboBoxItem>
                    <ComboBoxItem Tag="DescendingByDateVisited">Descending By DateVisited</ComboBoxItem>
                </ComboBox>
            </controls:SettingsCard>
        </StackPanel>

    </StackPanel>
</Page>
