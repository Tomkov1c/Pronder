<Page
    x:Class="Pronder.Views.NewProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="8">
            <InfoBar IsOpen="False" Severity="Error" Title="Error" IsClosable="False"
                     Message="The project must have a name at least." x:Name="InfoBar"/>
            <StackPanel Orientation="Vertical" Spacing="4">
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.Transitions>
                <controls:SettingsCard Header="Name"
                                       Description="Name you new or already existing project">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource Icon8Outline}" Glyph="&#xe907;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox PlaceholderText="Name" Width="250" Text="{Binding Name, Mode=TwoWay}"
                             x:Name="NameTextBox"/>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Tag"
                                       Description="What is your project">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource Icon8Outline}" Glyph="&#xe906;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox PlaceholderText="Tag" Width="250" Text="{Binding Tag, Mode=TwoWay}"/>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Description"
                                       Description="Describe your project" ContentAlignment="Vertical" 
                                       HorizontalContentAlignment="Stretch">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource Icon8Outline}" Glyph="&#xe905;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox PlaceholderText="Description" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding Description, Mode=TwoWay}"/>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Icon"
                                       Description="Give your project an icon so it can be easaly spoted from the side bar" >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource Icon8Outline}" Glyph="&#xe904;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <Button HorizontalAlignment="Right" Margin="0, 0, 10, 0" Padding="8"
                            Command="{Binding OpenFilePickerCommand}" CommandParameter="Icon">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xEC50;" FontSize="15"/>
                                <TextBlock Text="Pick a file" Style="{StaticResource BodyTextBlockStyle}"
                                           Margin="8, 0, 0, 0"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Banner"
                                       Description="Give your project a banner" >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource Icon8Outline}" Glyph="&#xe903;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <Button HorizontalAlignment="Right" Margin="0, 0, 10, 0" Padding="8" 
                            Command="{Binding OpenFilePickerCommand}" CommandParameter="Banner">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xEC50;" FontSize="15"/>
                                <TextBlock Text="Pick a file" Style="{StaticResource BodyTextBlockStyle}"
                                           Margin="8, 0, 0, 0"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </controls:SettingsCard>

                <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Padding="8, 8" Command="{Binding CreateProjectCommand}"
                        Click="CreateClicked" Margin="0, 12">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE710;" FontSize="15"/>
                        <TextBlock Text="Create" Style="{StaticResource BodyTextBlockStyle}"
                                   Margin="8, 0, 0, 0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
