<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pronder.Views.ProjectBudgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pronder.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <TransitionCollection x:Key="ListviewTransitions">
            <AddDeleteThemeTransition />
            <ContentThemeTransition />
        </TransitionCollection>

        <DataTemplate x:Key="ItemTemplate">
            <Grid Padding="16" Margin="0, 0, 0, 4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="{StaticResource ControlCornerRadius}" HorizontalAlignment="Stretch"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" MinWidth="75"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" MinWidth="75"/>
                </Grid.ColumnDefinitions>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Icon="Delete" Text="Delete" Command="{Binding DataContext.RemoveItemCommand, ElementName=ItemList}"
                                        CommandParameter="{Binding}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                
                <TextBlock Text="{Binding Amount}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Grid.Column="0" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{Binding Foreground}"/>
                <StackPanel Orientation="Vertical" Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Date}" Style="{StaticResource BodyTextBlockStyle}" Grid.Column="2" HorizontalAlignment="Right" 
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    
    
    <StackPanel Orientation="Vertical" MinHeight="550" Spacing="12" >
        <Button HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="18"/>
                    <TextBlock Text="Add"/>
                </StackPanel>
            </Button.Content>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Orientation="Vertical" Spacing="12">
                        <controls:Segmented HorizontalAlignment="Stretch" 
                                            SelectedIndex="{Binding SelectedItemTypeIndex, Mode=TwoWay}">
                            <controls:SegmentedItem Content="Expense" Icon="{ui:FontIcon Glyph=&#xE73C;}"/>
                            <controls:SegmentedItem Content="Income" Icon="{ui:FontIcon Glyph=&#xE710;}"/>
                        </controls:Segmented>
                        <TextBox Width="300" Text="{Binding NewItemName, Mode=TwoWay}" PlaceholderText="Name"/>
                        <TextBox Width="300" Text="{Binding NewItemDescription, Mode=TwoWay}" PlaceholderText="Description"/>
                        <NumberBox Width="300" Text="{Binding NewItemAmount, Mode=TwoWay}" PlaceholderText="Amount"/>

                        <Button Content="Add" Style="{StaticResource AccentButtonStyle}" Command="{Binding AddItemCommand}"
                                Margin="0, 12, 0, 0" HorizontalAlignment="Stretch">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Invoked="EnterPressed"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
        <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  Height="300" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="{StaticResource OverlayCornerRadius}" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Orientation="Vertical" Grid.Row="0">
                    <TextBlock Text="Remaining budget" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Grid.Column="0"/>
                    <TextBlock Text="{Binding CurrentBudget, Mode=OneWay}" HorizontalAlignment="Center"
                               Style="{StaticResource DisplayTextBlockStyle}"/>

                </StackPanel>
               

                <Grid VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Grid.Row="1"
                      Padding="16, 24" BorderThickness="0, 1, 0, 0" BorderBrush="{ThemeResource ControlFillColorSecondaryBrush}"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="{Binding NegateNoItems}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Initial budget" HorizontalAlignment="Left" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Grid.Column="0"/>
                    <TextBlock Text="{Binding InitialBudget}" HorizontalAlignment="Right"
                               Style="{StaticResource BodyTextBlockStyle}" Grid.Column="1"/>
                </Grid>

            </Grid>
            <StackPanel Orientation="Vertical" Grid.Column="1">
                <ListView x:Name="ItemList"
                          ItemsSource="{Binding Items, Mode=TwoWay}" 
                          ItemTemplate="{StaticResource ItemTemplate}"
                          ItemContainerTransitions="{StaticResource ListviewTransitions}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                          SelectionMode="None"
                          MinHeight="525" Margin="-12, 0" Visibility="{Binding NegateNoItems}"/>
                <TextBlock HorizontalAlignment="Center" Text="Budget hasnt been spent" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" Visibility="{Binding NoItems}"/>
                
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>
