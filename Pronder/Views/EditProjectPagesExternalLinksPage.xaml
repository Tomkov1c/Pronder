<Page
    x:Class="Pronder.Views.EditProjectPagesExternalLinksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

	<ScrollViewer x:Name="ContentArea" Padding="10, 32, 18, 10">
		<StackPanel Orientation="Vertical" Padding="0, 42, 0, 12" Spacing="12">
			<TextBlock Text="External links" Style="{StaticResource TitleTextBlockStyle}" Padding="0, 0, 0, 24"/>
			<CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Left" Margin="-5, 0, 0, 0">
				<AppBarButton Icon="Add" Label="Add">
					<AppBarButton.Flyout>
						<Flyout>
							<StackPanel Orientation="Horizontal">
								<TextBox />
							</StackPanel>
						</Flyout>
					</AppBarButton.Flyout>
				</AppBarButton>
				<AppBarButton Icon="Edit" Label="Edit"/>
				<AppBarButton Icon="Share" Label="Share"/>
			</CommandBar>
		</StackPanel>
	</ScrollViewer>
</Page>
