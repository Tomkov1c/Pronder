<Page
    x:Class="Pronder.Views.ProjectToDoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:data="using:Pronder.Models"
    xmlns:local="using:Pronder.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <TransitionCollection x:Key="ListviewTransitions">
            <AddDeleteThemeTransition />
            <ContentThemeTransition />
        </TransitionCollection>

        <DataTemplate x:Key="TaskWithSubtasksTemplate">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Padding="0, 14" Spacing="4">
                    <CheckBox CornerRadius="12" MinWidth="0" IsChecked="{Binding Done}" />
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Stretch" Text="{Binding Content}" />
                    <StackPanel.ContextFlyout>
                        <CommandBarFlyout Placement="BottomEdgeAlignedLeft" AlwaysExpanded="True">
                            <AppBarButton Label="Delete Sub" Icon="Delete" ToolTipService.ToolTip="Delete" 
                                          Command="{Binding DataContext.RemoveTaskCommand, ElementName=MainListView}"
                                          CommandParameter="{Binding}"/>
                        </CommandBarFlyout>
                    </StackPanel.ContextFlyout>
                </StackPanel>

                <ListView ItemsSource="{Binding VMSubTasks}"
                          ItemTemplateSelector="{StaticResource TaskTemplateSelector}"
                          Margin="16,0,0,0" SelectionMode="None"
                          ItemContainerTransitions="{StaticResource ListviewTransitions}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TaskWithoutSubtasksTemplate">
            <StackPanel Orientation="Horizontal" Padding="0, 14">
                <CheckBox CornerRadius="12" MinWidth="0" IsChecked="{Binding Done}" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Stretch" Text="{Binding Content}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MainTaskTemplateWithSubtasks">
            <controls:SettingsExpander Margin="-10, 0, -10, 5">
                <controls:SettingsExpander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox CornerRadius="12" MinWidth="0" IsChecked="{Binding Done}" 
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Content}" VerticalAlignment="Center"/>
                    </StackPanel>
                </controls:SettingsExpander.Header>
                <controls:SettingsExpander.Items>
                    <ListView ItemsSource="{Binding VMSubTasks}"
                              ItemTemplateSelector="{StaticResource TaskTemplateSelector}"
                              Margin="16,0,0,0" SelectionMode="None" 
                              ItemContainerTransitions="{StaticResource ListviewTransitions}" />
                </controls:SettingsExpander.Items>
                <controls:SettingsExpander.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit" Icon="Edit" ToolTipService.ToolTip="Edit"
                                        Command="{Binding DataContext.EditTaskCommand, ElementName=MainListView}"/>
                        <MenuFlyoutItem Text="Delete" Icon="Delete" ToolTipService.ToolTip="Delete" 
                                        Command="{Binding DataContext.RemoveTaskCommand, ElementName=MainListView}" 
                                        CommandParameter="{Binding}"/>
                    </MenuFlyout>
                </controls:SettingsExpander.ContextFlyout>
            </controls:SettingsExpander>
        </DataTemplate>

        <DataTemplate x:Key="MainTaskTemplate">
            <controls:SettingsCard Margin="-10, 0, -10, 5">
                <controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox CornerRadius="12" MinWidth="0" IsChecked="{Binding Done}" 
                          VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Content}" VerticalAlignment="Center"/>
                    </StackPanel>
                </controls:SettingsCard.Header>
                <controls:SettingsCard.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit" Icon="Edit" ToolTipService.ToolTip="Edit"
                                        Command="{Binding DataContext.EditTaskCommand, ElementName=MainListView}"/>
                        <MenuFlyoutItem Text="Delete" Icon="Delete" ToolTipService.ToolTip="Delete" 
                                        Command="{Binding DataContext.RemoveTaskCommand, ElementName=MainListView}" 
                                        CommandParameter="{Binding}"/>
                    </MenuFlyout>
                </controls:SettingsCard.ContextFlyout>
            </controls:SettingsCard>
        </DataTemplate>

        <local:TaskTemplateSelector x:Key="TaskTemplateSelector"
                                    TaskWithoutSubtasks="{StaticResource TaskWithoutSubtasksTemplate}"
                                    TaskWithSubtasks="{StaticResource TaskWithSubtasksTemplate}" 
                                    MainTaskTemplate="{StaticResource MainTaskTemplate}"
                                    MainTaskTemplateWithSubtasks= "{StaticResource MainTaskTemplateWithSubtasks}"/>
    </Page.Resources>

    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" MinHeight="550">
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <controls:Segmented  SelectedIndex="0" SelectionMode="Single" HorizontalAlignment="Left" Grid.Column="0">
                <controls:SegmentedItem Icon="{ui:FontIcon Glyph=&#xEA3A;}" IsSelected="True"/>
                <controls:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE930;}" />
            </controls:Segmented>
            <Button HorizontalAlignment="Right" Grid.Column="2">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="18"/>
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox  Width="300" x:Name="NewTaskContentTextBox"/>
                            <Button Content="Add" Style="{StaticResource AccentButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" />
                                </Button.KeyboardAccelerators>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <ListView x:Name="MainListView" ItemsSource="{Binding Tasks}" 
                  ItemTemplateSelector="{StaticResource TaskTemplateSelector}"
                  SelectionMode="None" Margin="-6, 18, -2, 0" MinHeight="500"
                  ItemContainerTransitions="{StaticResource ListviewTransitions}" />
    </StackPanel>
</Page>
