<Page
    x:Class="Pronder.Views.EditProjectPagesBudgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer x:Name="ContentArea" Padding="10, 0, 18, 10">
        <StackPanel Orientation="Vertical" Padding="0, 42, 0, 12" Spacing="4">
            <TextBlock Text="Budget" Style="{StaticResource TitleTextBlockStyle}" Padding="0, 0, 0, 24"/>

            <controls:SettingsCard Header="Budget" HeaderIcon="{ui:FontIcon Glyph=&#xE825;}" IsEnabled="True">
                <NumberBox Width="300" PlaceholderText="500" x:Name="NameTextBox" 
                           Text="{Binding Budget, Mode=TwoWay}"/>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
