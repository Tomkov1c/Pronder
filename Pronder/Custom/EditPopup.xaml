<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pronder.Custom.EditPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pronder.Custom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CornerRadius="{StaticResource OverlayCornerRadius}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">1300</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
            <x:Double x:Key="ContentDialogMinWidth">700</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">550</x:Double>
            <Thickness x:Key="ContentDialogPadding">0</Thickness>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid Width="1000" Height="500" x:Name="MainGrid" MinHeight="550" MinWidth="700" MaxHeight="1000" MaxWidth="1300">
        <Grid x:Name="NavPanel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NavigationView x:Name="NavView" IsSettingsVisible="False" IsPaneOpen="True" SelectionChanged="NavSelectionChanged"
                            IsPaneToggleButtonVisible="False" ExpandedModeThresholdWidth="200" Grid.Column="0"
                            OpenPaneLength="200" Width="200" IsBackButtonVisible="Collapsed" Margin="0, 0, 0 , 80">
                <NavigationView.MenuItems>
                    <NavigationViewItemHeader Content="Edit" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <NavigationViewItem Content="General" Icon="Page2" IsSelected="True" x:Name="FirstNavItem"/>
                    <NavigationViewItem Content="External links" Icon="Link" />
                </NavigationView.MenuItems>
            </NavigationView>
            <ScrollViewer HorizontalAlignment="Stretch"
                          Margin="0, 0, 0 , 80" x:Name="FrameScrollViewer" Grid.Column="1">
                <Frame x:Name="NavigationFrame" Margin="0, -2, 0 ,0">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition  />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </ScrollViewer>
        </Grid>

        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MinWidth="700"
              Padding="0, 24, 24, 24" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Button Content="Close" Width="150" Click="CloseButton" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</ContentDialog>
