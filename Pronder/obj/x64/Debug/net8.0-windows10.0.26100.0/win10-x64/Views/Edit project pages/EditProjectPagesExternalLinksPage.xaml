<Page
    x:Class="Pronder.Views.EditProjectPagesExternalLinksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mine="using:Pronder.Custom"
    mc:Ignorable="d">

	<ScrollViewer x:ConnectionId='2' x:Name="ContentArea" Padding="10, 32, 18, 10">
		<StackPanel Orientation="Vertical" Padding="0, 42, 0, 12">
			<TextBlock Text="External links" Style="{StaticResource TitleTextBlockStyle}" Margin="0, 0, 0, -6"/>
            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Left" 
                        Margin="-5, 12, 0, 8">
                <AppBarButton Icon="Link" Label="Add a website">
                    <AppBarButton.Flyout>
                        <Flyout x:ConnectionId='9' Placement="BottomEdgeAlignedLeft" x:Name="LinkFlyout">
                            <StackPanel Orientation="Vertical" Spacing="12" Width="400">
                                <TextBox x:ConnectionId='10' Header="Link" PlaceholderText="https://www." AllowFocusOnInteraction="True" 
                                         x:Name="LinkTextBox"/>
                                <TextBox x:ConnectionId='11' Header="Name" Description="Will be coppied from link if left empty." 
                                         PlaceholderText="idk" AllowFocusOnInteraction="True" x:Name="NameTextBox"/>
                                <Button x:ConnectionId='12' Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                        Content="Create"                       />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Folder" Label="Add a directory">
                    <AppBarButton.Flyout>
                        <Flyout x:ConnectionId='4' Placement="BottomEdgeAlignedLeft" x:Name="DirectoryFlyout">
                            <StackPanel Orientation="Vertical" Spacing="12" Width="400">
                                <StackPanel Orientation="Vertical">
                                    <TextBox x:ConnectionId='7' Header="Path" PlaceholderText="C:\User\" AllowFocusOnInteraction="True"
                                             x:Name="PathTextBox"/>
                                    <TextBlock Text="or" Padding="12, 0"/>
                                    <Button x:ConnectionId='8' Content="Select directory"                       />
                                </StackPanel>
                                <TextBox x:ConnectionId='5' Header="Name" Description="Will be coppied from link if left empty." 
                                         PlaceholderText="idk" AllowFocusOnInteraction="True" x:Name="NameTextBox2"/>
                                <Button x:ConnectionId='6' Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                        Content="Create"                       />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
            <StackPanel x:ConnectionId='3' Orientation="Vertical" x:Name="StackPanel" Spacing="4">
                
            </StackPanel>
        </StackPanel>
	</ScrollViewer>
</Page>

