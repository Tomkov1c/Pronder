<Page
    x:Class="Pronder.Views.EditProjectPagesGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Pronder.Custom"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer x:ConnectionId='2' x:Name="ContentArea" Padding="10, 32, 18, 10">
        <StackPanel Orientation="Vertical" Padding="0, 42, 0, 12" Spacing="12">
            <TextBlock x:ConnectionId='3' Text="General" x:Name="idk" Style="{StaticResource TitleTextBlockStyle}" Padding="0, 0, 0, 24"/>

            <local:Card Header="Name" Icon="&#xE8AC;">
                <local:Card.Child>
                    <TextBox x:ConnectionId='6' Width="200" PlaceholderText="E.g., Pronder" x:Name="NameTextBox" 
                                                                                        />
                </local:Card.Child>
            </local:Card>
            <local:BiggerCard Header="Description" Description="Describe your project." Icon="&#xE8E4;">
                <local:BiggerCard.Child>
                    <TextBox x:ConnectionId='5' AutomationProperties.Name="multi-line TextBox" TextWrapping="Wrap" 
                             AcceptsReturn="True" IsSpellCheckEnabled="True" PlaceholderText="E.g., a project manager."
                             x:Name="DescriptionTextBox"                                                            />
                </local:BiggerCard.Child>
            </local:BiggerCard>
            <local:Card Header="Tag" Description="Quickly categorize your project." Icon="&#xE8EC;">
                <local:Card.Child>
                    <TextBox x:ConnectionId='4' Width="200" PlaceholderText="E.g., app development" x:Name="TagTextBox" 
                                                                                        />
                </local:Card.Child>
            </local:Card>

            <StackPanel Orientation="Vertical" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" >
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16, 16" 
                      CornerRadius="{StaticResource ControlCornerRadius}" MinHeight="70"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Canvas Margin="4, 0, 16, 0" Grid.Column="0" Width="25" Height="25">
                        <Viewbox Width="25" Height="25">
                            <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                                  Data="{StaticResource Image}"/>
                        </Viewbox>
                    </Canvas>

                    <StackPanel Orientation="Vertical" Margin="16, 0, 0, 0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Icon" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Leave empty if your project doesnt have an icon yet." 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEC50;" FontSize="14"/>
                                <TextBlock Text="Choose an image" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
                <StackPanel Orientation="Vertical" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="32">
                    <Border CornerRadius="{StaticResource OverlayCornerRadius}" Height="130" Width="130"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Background="{ThemeResource LayerFillColorAltBrush}">
                        <Image Source="ms-appx:///Assets/Icon8/Color/icons8-website-512.png"  HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch" Margin="16"/>
                    </Border>
                    <TextBlock Text="File path:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0, 16, 0, 0"/>
                    <TextBlock Text="File name:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0, 16, 0, 0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                      BorderThickness="1" 
                      Padding="16, 16" 
                      CornerRadius="{StaticResource ControlCornerRadius}" 
                      MinHeight="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Canvas Margin="4, 0, 16, 0" Grid.Column="0" Width="25" Height="25">
                        <Viewbox Width="25" Height="25">
                            <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                                  Data="{StaticResource Panorama}"/>
                        </Viewbox>
                    </Canvas>

                    <StackPanel Orientation="Vertical" Margin="16, 0, 0, 0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Banner" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Leave empty if your project doesnt have a banner yet." 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEC50;" FontSize="14"/>
                                <TextBlock Text="Choose an image" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

