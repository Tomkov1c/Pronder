<Page
    x:Class="Pronder.Views.EditProjectPagesExternalLinksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mine="using:Pronder.Custom"
    mc:Ignorable="d">

	<ScrollViewer x:ConnectionId='2' x:Name="ContentArea" Padding="10, 32, 18, 10">
		<StackPanel x:ConnectionId='3' Orientation="Vertical" Padding="0, 42, 0, 12" Spacing="12" x:Name="StackPanel">
			<TextBlock Text="External links" Style="{StaticResource TitleTextBlockStyle}" Margin="0, 0, 0, -6"/>
            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Left" Margin="-5, 0, 0, 0">
                <AppBarButton Icon="Add" Label="Add">
                    <AppBarButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <ComboBox MinWidth="300" Header="Type">
                                    <x:String>Web link</x:String>
                                    <x:String>File path</x:String>
                                </ComboBox>
                                <TextBox Header="Name" MinWidth="300"/>
                                <TextBox  AcceptsReturn="True" IsSpellCheckEnabled="True" TextWrapping="Wrap" 
                                          Header="Path" MinWidth="300"/>
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Add" MinWidth="300"/>
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Delete" Label="Delete all"/>
            </CommandBar>
        </StackPanel>
	</ScrollViewer>
</Page>

